# Copy to .env and change every secret before deploying.

# Public host name (Caddy gets a TLS certificate for it)
BASA_HOST=localhost
PHX_HOST=localhost
SECRET_KEY_BASE=generate-with-mix-phx.gen.secret
TOKEN_SIGNING_SECRET=generate-with-mix-phx.gen.secret

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basa_dev
POSTGRES_PORT=5432

# RustFS (S3-compatible)
S3_ACCESS_KEY=basa
S3_SECRET_KEY=basa-secret
S3_BUCKET=basa-media
S3_PORT=9000
S3_CONSOLE_PORT=9001

# RabbitMQ
RABBITMQ_USER=basa
RABBITMQ_PASSWORD=basa
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Meilisearch
MEILI_MASTER_KEY=basa-dev-master-key-change-me
MEILI_ENV=development
MEILI_PORT=7700

# Stalwart (mail)
SMTP_PORT=2525
SUBMISSION_PORT=5870
STALWART_ADMIN_PORT=8090

# EU DSS (qualified signature check). On the server use the empty trust dir:
# extra anchors there never make a signature qualified, only the EU lists do.
DSS_PORT=8095
DSS_TRUST_DIR=./docker/dss/no-trust

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Claude (photo recognition). Leave empty to disable suggestions.
ANTHROPIC_API_KEY=

# Street view near rooms (optional): a Mapillary client token,
# made at https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Payments (Hyperswitch). Local sandbox: docker/hyperswitch/up.sh, then mix basa.hyperswitch.setup
HYPERSWITCH_URL=
HYPERSWITCH_API_KEY=
HYPERSWITCH_PROFILE_ID=
HYPERSWITCH_WEBHOOK_KEY=
