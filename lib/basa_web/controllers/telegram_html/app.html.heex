<BasaTma.Components.entry
  to={@to}
  signing_in={gettext("Signing you in…")}
  outside={gettext("Open this page from the BASA bot in Telegram.")}
  failed={gettext("Sign-in failed. Close and reopen the app.")}
>
  <img src={~p"/images/icon-512.png"} alt="BASA" class="size-20 rounded-2xl" />
  <p class="text-2xl font-black">BASA</p>
  <.spinner size="medium" color="primary" />
</BasaTma.Components.entry>
